{
  "name": "bs-community/blessing-skin-server",
  "description": "A web application brings your custom skins back in offline Minecraft servers.",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "ext-ctype": "*",
    "ext-gd": "*",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "blessing/filter": "1.4.0+dreamcraft.1",
    "blessing/rejection": "1.4.0+dreamcraft.1",
    "blessing/texture-renderer": "^0.2",
    "composer/ca-bundle": "^1.2",
    "composer/semver": "^3.2",
    "doctrine/dbal": "^3.0",
    "doctrine/inflector": "^2.0",
    "spatie/laravel-ignition": "^2.0",
    "gregwar/captcha": "1.*",
    "guzzlehttp/guzzle": "^7.0",
    "intervention/image": "^2.7",
    "laravel/framework": "^12.71",
    "laravel/passport": "^12.4.3",
    "lorisleiva/laravel-search-string": "1.3.0+dreamcraft.1",
    "nesbot/carbon": "^3.0",
    "nunomaduro/collision": "^8.0",
    "rcrowe/twigbridge": "^0.14",
    "spatie/laravel-translation-loader": "^2.7",
    "symfony/process": "^7.2",
    "symfony/yaml": "^7.2",
    "twig/twig": "^3.0",
    "vectorface/whip": "^0.4.0",
    "firebase/php-jwt": "^7.2.2"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^3.5",
    "barryvdh/laravel-ide-helper": "^3.0",
    "fakerphp/faker": "^1.13",
    "friendsofphp/php-cs-fixer": "^3.13",
    "laravel/browser-kit-testing": "^7.3",
    "laravel/tinker": "^2.4",
    "mockery/mockery": "^1.4",
    "phpunit/phpunit": "^11.5.50",
    "symfony/css-selector": "^7.2",
    "symfony/dom-crawler": "^7.2"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "platform": {
      "php": "8.5.0"
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/socialite"
      ]
    }
  },
  "repositories": {
    "rejection-laravel12": {
      "type": "package",
      "package": {
        "name": "blessing/rejection",
        "description": "Rejection is an object that indicates you are rejecting.",
        "license": [
          "MIT"
        ],
        "authors": [
          {
            "name": "Pig Fang",
            "email": "g-plane@hotmail.com"
          }
        ],
        "source": {
          "type": "git",
          "url": "https://github.com/bs-community/rejection.git",
          "reference": "df4961d2f6c1557aaf1092680888e4be333e89bb"
        },
        "dist": {
          "type": "zip",
          "url": "https://api.github.com/repos/bs-community/rejection/zipball/df4961d2f6c1557aaf1092680888e4be333e89bb",
          "reference": "df4961d2f6c1557aaf1092680888e4be333e89bb",
          "shasum": ""
        },
        "autoload": {
          "psr-4": {
            "Blessing\\": "src/Blessing"
          }
        },
        "require": {
          "illuminate/support": "^12.0"
        },
        "version": "1.4.0+dreamcraft.1"
      }
    },
    "filter-laravel12": {
      "type": "package",
      "package": {
        "name": "blessing/filter",
        "description": "Filters API for designing plugin system.",
        "license": [
          "MIT"
        ],
        "authors": [
          {
            "name": "Pig Fang",
            "email": "g-plane@hotmail.com"
          }
        ],
        "source": {
          "type": "git",
          "url": "https://github.com/bs-community/filter.git",
          "reference": "725c5b56ff7736027a5b7908c660f7b4db694a0e"
        },
        "dist": {
          "type": "zip",
          "url": "https://api.github.com/repos/bs-community/filter/zipball/725c5b56ff7736027a5b7908c660f7b4db694a0e",
          "reference": "725c5b56ff7736027a5b7908c660f7b4db694a0e",
          "shasum": ""
        },
        "autoload": {
          "psr-4": {
            "Blessing\\": "src/Blessing"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "Blessing\\FilterServiceProvider"
            ]
          }
        },
        "require": {
          "illuminate/contracts": "^12.0",
          "illuminate/support": "^12.0"
        },
        "version": "1.4.0+dreamcraft.1"
      }
    },
    "search-string-laravel12": {
      "type": "package",
      "package": {
        "name": "lorisleiva/laravel-search-string",
        "description": "Generates database queries based on one unique string using a simple and customizable syntax.",
        "license": [
          "MIT"
        ],
        "authors": [
          {
            "name": "Loris Leiva",
            "email": "loris.leiva@gmail.com"
          }
        ],
        "source": {
          "type": "git",
          "url": "https://github.com/lorisleiva/laravel-search-string.git",
          "reference": "3842079d0fe6315a3a24dbc30c15ed590c635357"
        },
        "dist": {
          "type": "zip",
          "url": "https://api.github.com/repos/lorisleiva/laravel-search-string/zipball/3842079d0fe6315a3a24dbc30c15ed590c635357",
          "reference": "3842079d0fe6315a3a24dbc30c15ed590c635357",
          "shasum": ""
        },
        "autoload": {
          "psr-4": {
            "Lorisleiva\\LaravelSearchString\\": "src"
          }
        },
        "extra": {
          "laravel": {
            "providers": [
              "Lorisleiva\\LaravelSearchString\\ServiceProvider"
            ]
          }
        },
        "require": {
          "hoa/compiler": "^3.17",
          "illuminate/support": "^12.0",
          "php": "^8.1",
          "sanmai/hoa-protocol": "^1.17"
        },
        "version": "1.3.0+dreamcraft.1"
      }
    },
    "packagist": {
      "type": "composer",
      "url": "https://packagist.org/"
    }
  }
}
